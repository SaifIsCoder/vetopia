{
  "name": "vetopia-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev:android": "eas build --profile development --platform android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:e2e": "maestro test .maestro/",
    "test:e2e:smoke": "maestro test --include-tags=smoke .maestro/",
    "test:e2e:auth": "maestro test --include-tags=auth .maestro/",
    "server": "tsx --env-file-if-exists=.env src/server/server.ts",
    "seed": "tsx --env-file-if-exists=.env src/server/scripts/seedUsers.ts",
    "server:prod": "tsx src/server/server.ts",
    "db:push": "supabase db push",
    "db:link": "supabase link --project-ref oqqdznxlqnscvhlluiit"
  },
