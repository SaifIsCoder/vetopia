# API Gateway URL (Node.js / Express backend)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Supabase Client Configuration (Public Anon Key only - Never commit service-role keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Environment Identifier: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# LiveKit Cloud RTC SFU (Client non-secret URL)
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# BACKEND ONLY SECRETS (Never place in mobile client, Expo public config, or client bundle)
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
